<?xml version="1.0" encoding="UTF-8"?>
<!-- Bundle template for "fpvOS Recovery.app". The recovery-app workflow copies
     this into Contents/Info.plist and substitutes __VERSION__ with the crate
     version. The app is a normal (non-sandboxed) GUI that self-elevates for the
     USB step via osascript; it needs no special entitlements. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>fpvOS Recovery</string>
    <key>CFBundleDisplayName</key>
    <string>fpvOS Recovery</string>
    <key>CFBundleIdentifier</key>
    <string>com.gehee.fpvos-recovery</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleExecutable</key>
    <string>fpvos-recovery</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
</dict>
</plist>
